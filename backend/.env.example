# API Security
API_KEY=supersecret

# Database Configuration
DATABASE_URL=sqlite:///./data.db

# AI Integration (Optional - will fallback to local models if not provided)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# CORS Configuration for Production
# For development, use "*" or leave empty
# For production, set to your frontend domain(s) separated by commas
# Example: CORS_ORIGINS=https://yourapp.vercel.app,https://yourapp.com
CORS_ORIGINS=*
