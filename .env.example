# Environment Variables Configuration
# Copy this file to .env and modify the values as needed

# Server/Host Configuration
# Replace with your server's IP address or domain when deploying
HOST_IP=localhost
DOMAIN=localhost

# API Configuration
# Change this to a secure random string in production
API_KEY=supersecret

# OpenAI API Key (required for AI features)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Frontend Configuration
# Port for the frontend service
FRONTEND_PORT=3000

# Backend API URL for the frontend to connect to
# When deploying, change this to your server's IP/domain
# Examples:
# - Local development: http://localhost:8000
# - Server with IP: http://YOUR_SERVER_IP:8000
# - Server with domain: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8000

# CORS Origins for backend
# Comma-separated list of allowed origins
# Examples:
# - Local: http://localhost:3000
# - Server with IP: http://YOUR_SERVER_IP:3000
# - Server with domain: https://yourdomain.com
# - Multiple origins: http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000

# Redis Configuration
REDIS_PORT=6380

# PostgreSQL Configuration (usually don't need to change these)
POSTGRES_PORT=5432
BACKEND_PORT=8000
